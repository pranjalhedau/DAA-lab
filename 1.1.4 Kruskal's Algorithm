#include <stdio.h>
#include <stdlib.h>
#include <limits.h>



void kruskalMST(int **cost, int V) {

	int parent[V];

    // Initially, every vertex is its own parent
    for (int i = 0; i < V; i++) {
        parent[i] = i;
    }

    int edgeCount = 0;
    int totalCost = 0;

    while (edgeCount < V - 1) {
        int min = INT_MAX;
        int u = -1;
        int v = -1;

        // Find the minimum weight edge
        // in row-wise upper triangular order
        for (int i = 0; i < V; i++) {
            for (int j = i + 1; j < V; j++) {
                if (cost[i][j] < min) {
                    min = cost[i][j];
                    u = i;
                    v = j;
                }
            }
        }

        // Find parent of u
        int x = u;
        while (parent[x] != x) {
            x = parent[x];
        }

        // Find parent of v
        int y = v;
        while (parent[y] != y) {
            y = parent[y];
        }

        // If they belong to different sets, include edge
        if (x != y) {
            printf("Edge %d:(%d, %d) cost:%d\n",
                   edgeCount, u, v, min);

            totalCost += min;
            edgeCount++;

            parent[x] = y;
        }

        // Mark this edge as processed
        cost[u][v] = INT_MAX;
        cost[v][u] = INT_MAX;
    }

    printf("Minimum cost= %d\n", totalCost);
	
}


int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
